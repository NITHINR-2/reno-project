# Copy to backend/.env (git-ignored). Loaded via spring.config.import.
DB_URL=jdbc:postgresql://localhost:5432/fleet
DB_USERNAME=fleet
# Must match POSTGRES_PASSWORD in the root .env
DB_PASSWORD=change-me

# JWT HS256 signing secret, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-bytes

# Dev-profile seed user passwords (used from Phase 1 onward; dev profile only)
DEV_ADMIN_PASSWORD=change-me
DEV_SUPERVISOR_PASSWORD=change-me
DEV_MARKETING_MANAGER_PASSWORD=change-me
DEV_MARKETING_HEAD_PASSWORD=change-me
DEV_FINANCE_PASSWORD=change-me
